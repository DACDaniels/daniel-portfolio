# Resend API key for the /api/contact route.
# Get one at https://resend.com/api-keys
# Copy this file to .env.local and fill in a real key for local dev.
# In production, set this in the Vercel project's Environment Variables.
RESEND_API_KEY=re_your_key_here

# GitHub token for the "Shipping, every week" graph in How I build
# (contribution calendar only; a classic token with read:user is enough).
# Without it the graph is simply hidden. Never commit the real value.
GITHUB_CONTRIBUTIONS_TOKEN=
